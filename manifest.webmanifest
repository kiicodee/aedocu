{
  "name": "aedocu · Alat PDF tanpa upload",
  "short_name": "aedocu",
  "description": "Kompres, gabung, pisah, atur halaman, dan ubah PDF ke gambar atau sebaliknya. Semua diproses di perangkatmu: tanpa upload, tanpa batas, tanpa iklan, bisa offline.",
  "lang": "id",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    { "name": "Kompres PDF", "url": "./tools/kompres/" },
    { "name": "Gabung PDF", "url": "./tools/gabung/" },
    { "name": "Pisah PDF", "url": "./tools/pisah/" },
    { "name": "Gambar ke PDF", "url": "./tools/gambar-ke-pdf/" }
  ],
  "file_handlers": [
    {
      "action": "./tools/kompres/",
      "accept": {
        "application/pdf": [".pdf"]
      }
    }
  ]
}
